# Volcengine. Leave VOLCENGINE_API_KEY empty only for private deployments
# where the browser page will provide the key per recognition request.
VOLCENGINE_API_KEY=
VOLCENGINE_RESOURCE_ID=volc.seedasr.auc
VOLCENGINE_MODEL_VERSION=400

# Aliyun DashScope (Paraformer-v2 / Fun-ASR / Qwen-ASR)
DASHSCOPE_API_KEY=

# Tencent Cloud ASR
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou

# Cloud Storage Upload (Optional, for local deployment without intranet penetration)
# Supported values: cos | oss | empty (local URL)
UPLOAD_PROVIDER=

# Tencent Cloud COS Configs (Optional, falls back to TENCENT_SECRET_ID/KEY/REGION)
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=

# Aliyun OSS Configs (Optional)
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=

# Server
PORT=8789
PUBLIC_BASE_URL=
DATA_DIR=data
MAX_UPLOAD_MB=500
ALLOWED_ORIGIN=*
